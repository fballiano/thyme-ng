    "Starts the thyme-ng stopwatch if it is stopped, pauses it if it runs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Stoppuhr von thyme-ng, wenn sie steht, und pausiert sie, wenn sie läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el cronómetro de thyme-ng si está parado, lo pausa si está en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre le chronomètre de thyme-ng s'il est arrêté, le suspend s'il fonctionne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia il cronometro di thyme-ng se è fermo, lo mette in pausa se è in funzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o cronômetro do thyme-ng se ele está parado, o pausa se ele está em execução."
          }
        }
      }
    },
