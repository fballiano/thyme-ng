        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa el cronómetro de thyme-ng y conserva el tiempo transcurrido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspend le chronomètre de thyme-ng et conserve le temps écoulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette in pausa il cronometro di thyme-ng e conserva il tempo trascorso."
          }
